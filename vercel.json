{
  "trailingSlash": false,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/multipleksny-proryv",
      "destination": "/blog/pcr-panely-pp1875-vtoroy-lishniy",
      "statusCode": 301
    },
    {
      "source": "/drafts/:path*",
      "destination": "/blog",
      "statusCode": 302
    }
  ],
  "headers": [
    {
      "source": "/blog/_cards/:file*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    }
  ]
}
